# ======================================================================
# zklw media server — environment configuration
# Copy to `.env` on zklw and edit. Never commit the real .env (secrets).
# ======================================================================

# --- The ONE switch that moves the whole library between disks ----------
# Point this at the 20TB block storage once it is mounted.
# Until then you CAN point it at NVMe for a proof-of-concept (see README).
#
#   20TB (target):   MEDIA_ROOT=/mnt/media
#   NVMe (interim):  MEDIA_ROOT=/srv/media   (on the existing 1.8TB disk)
#
# Everything (downloads + library) lives UNDER this single root so that
# Radarr imports use instant hardlinks instead of slow cross-disk copies.
MEDIA_ROOT=/mnt/media

# --- Config/state for each service (small, fine on the NVMe/system disk) -
# Keeps service databases off the big media volume so the media volume can
# be a dumb bulk store. ~few hundred MB total.
CONFIG_ROOT=/opt/zklw-media/config

# --- Tailscale bind address --------------------------------------------
# Services bind ONLY to this address, so nothing is reachable from the
# public internet — only from inside your tailnet. zklw's tailscale IP:
TS_BIND=100.78.63.67

# --- User/group the containers run as (so files aren't owned by root) ---
# Get these on zklw with:  id -u   and   id -g   (for the `mk` user)
PUID=1000
PGID=1000
TZ=America/New_York

# --- Service ports (only exposed on TS_BIND, i.e. the tailnet) ----------
JELLYFIN_PORT=8096
JELLYSEERR_PORT=5055
RADARR_PORT=7878
SONARR_PORT=8989
PROWLARR_PORT=9696
QBITTORRENT_PORT=8080
QBITTORRENT_BT_PORT=6881
SABNZBD_PORT=8081
